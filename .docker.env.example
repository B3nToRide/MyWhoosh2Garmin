# Non-secret configuration only. Pass explicitly with --env-file .docker.env.
# Replace UID/GID with the output of `id -u` and `id -g` on the Mac.
CONTAINER_UID=501
CONTAINER_GID=20
MYWHOOSH_EMAIL_SECRET_FILE=/Users/YOUR_USER/.config/mywhoosh2garmin/mywhoosh_email
MYWHOOSH_PASSWORD_SECRET_FILE=/Users/YOUR_USER/.config/mywhoosh2garmin/mywhoosh_password
TZ=Europe/Paris

# daily: local wall-clock time, including daylight-saving changes.
SCHEDULE_MODE=daily
SCHEDULE_TIME=20:00
# To use elapsed time instead: SCHEDULE_MODE=interval
SCHEDULE_INTERVAL=4h

SYNC_MAX_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=300
SYNC_TIMEOUT_SECONDS=1800
